#!/usr/bin/env node
/**
 * aip-tui — AIP Router dashboard (Ink/React rewrite)
 *
 * Desain ulang: log panel kini KOMPREHENSIF & TIDAK TERPOTONG.
 *  - Buffer in-memory besar (2000 entri).
 *  - Panel dapat di-scroll (k/j/↑/↓, PgUp/PgDn, g/G home/end).
 *  - Mode FULL LOG (F): seluruh layar jadi log viewer; panjang di-wrap penuh,
 *    tidak ada teks yang dipotong.
 *  - Setiap baris log diwarnai berdasarkan konten ([req]/[done]/[token]/[RTK]/
 *    error), mencerminkan struktur log server (stdout + JSONL di
 *    ~/.aip-router/router.jsonl).
 *
 * Teknis: tanpa build step — JSX ditulis sebagai react.createElement.
 * Styling memakai props React (color/bold), BUKAN ANSI escape literal.
 */
import React, { useState, useEffect, useRef, useCallback } from "react";
import { render, Box, Text, useApp, useInput } from "ink";
import Spinner from "ink-spinner";
import { spawn } from "child_process";
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "fs";
import { homedir } from "os";
import { join, dirname } from "path";
import { fileURLToPath } from "url";

const __dirname = dirname(fileURLToPath(import.meta.url));
const CONFIG_DIR = join(homedir(), ".aip-router");
const CONFIG_PATH = join(CONFIG_DIR, "config.json");

// ---- Config helpers ----
function loadConfig() {
  const base = existsSync(CONFIG_PATH)
    ? JSON.parse(readFileSync(CONFIG_PATH, "utf8"))
    : {};
  return {
    tokens: base.tokens || [],
    port: base.port || 20129,
    rtkEnabled: base.rtkEnabled !== false,
    cavemanEnabled: base.cavemanEnabled === true,
    cavemanLevel: base.cavemanLevel || "full",
    ponytailEnabled: base.ponytailEnabled === true,
    headroomEnabled: base.headroomEnabled === true,
    headroomThreshold: base.headroomThreshold || 80,
    defaultMaxTokens: base.defaultMaxTokens || 2048,
    rtkTruncate: base.rtkTruncate !== false,
  };
}
function saveConfig(cfg) {
  if (!existsSync(CONFIG_DIR)) mkdirSync(CONFIG_DIR, { recursive: true });
  writeFileSync(CONFIG_PATH, JSON.stringify(cfg, null, 2));
}

// h() = JSX tanpa build step
const h = React.createElement;

const HISTORY_MAX = 60;
const LOG_MAX = 2000; // entri log maksimum yang disimpan dalam buffer
const LOG_PANEL_HEIGHT = 16; // tinggi panel log di dashboard view

// ---- Styling log berdasarkan konten (mencocokkan struktur log server) ----
// Prioritas: baris-error selalu merah; token cyan; RTK hijau; done putih;
// req cyan-baru; sisanya putih.
function styleLogLine(text) {
  const t = text;
  const isErr =
    /\[error\]|\[warn\]|threw:|failed:|Exception|Unauthorized|Too Many Requests|Bad Request|Internal Server Error|ReferenceError|circuit open/i.test(t);
  if (isErr) return { color: "red" };
  if (t.includes("[token]")) return { color: "cyan" };
  if (t.includes("[RTK]")) return { color: "green" };
  if (t.includes("[done]")) return { color: "white" };
  if (t.includes("[req]")) return { color: "blue" };
  if (t.startsWith("[Ingrazzio]")) return { color: "yellow" };
  return { color: "white", dimColor: true };
}
function statusToText(s) {
  if (s === null || s === undefined) return null;
  if (s < 200 || s >= 300) return null;
  return h(Text, { dimColor: true }, String(s));
}

// ---- Sparkline (ASCII block chart) ----
function Sparkline({ data, width = 14, height = 3, color = "cyan" }) {
  const samples = data.slice(-width);
  if (samples.length < 2) return h(Text, { dimColor: true }, " · menunggu ·");
  const max = Math.max(...samples.map(s => s.value), 1);
  const rows = [];
  for (let r = 0; r < height; r++) {
    let line = "";
    for (let c = 0; c < width; c++) {
      const idx = Math.max(0, samples.length - width + c);
      const hgt = Math.max(1, Math.round((samples[idx].value / max) * height));
      line += r < hgt ? "\u2588" : " ";
    }
    rows.push(h(Text, { key: r, color }, line));
  }
  return h(Box, { flexDirection: "column" }, rows);
}

// ---- Small presentational atoms ----
function Dot({ on }) {
  return h(Text, { color: on ? "green" : "gray" }, on ? "●" : "○");
}
function ToggleRow({ label, on, detail, color = "green" }) {
  return h(Box, {},
    h(Dot, { on }),
    h(Text, { dimColor: true }, ` ${label.padEnd(9)}`),
    h(Text, { bold: true, color: on ? color : "gray" }, on ? "ON" : "OFF"),
    detail ? h(Text, { dimColor: true }, `  ${detail}`) : null
  );
}

// ---- Multi-line wrapped log viewer ----
// Menampilkan entri log; teks panjang di-wrap penuh (tidak terpotong).
// `width` menentukan lebar kolom teks; `height` membatasi tinggi viewport.
// `scrollAt` = offset baris-render dari bawah (0 = paling baru).
function LogView({ entries, height, width, scrollAt = 0, colorMap }) {
  if (!entries.length) return h(Text, { dimColor: true }, "  (belum ada log)");

  // --- Bangun list "baris render" (sudah di-wrap, tanpa truncate) ---
  const renderRows = [];
  for (const e of entries) {
    const st = colorMap ? colorMap[e.id] : null;
    const t = `${e.time} ${e.text}`.trim();
    if (t.length === 0) { renderRows.push({ e, text: "", color: st?.color, dim: st?.dimColor }); continue; }
    // wrap manual ke chunk ≤ width (Ink Text wrap="wrap" juga bisa, tapi manual
    // memberi kontrol scroll dan menghitung tinggi dengan pasti)
    for (let i = 0; i < t.length; i += Math.max(1, width)) {
      renderRows.push({ e, text: t.slice(i, i + width), color: st?.color, dim: st?.dimColor });
    }
  }

  // scrollAt dalam jumlah baris-render dari bawah
  const total = renderRows.length;
  const from = Math.max(0, total - scrollAt - height);
  const to = Math.min(total, from + height);
  const visible = renderRows.slice(from, to);

  const lines = visible.map((r, i) =>
    h(Text, {
      key: `${r.e.id}-${i}`,
      color: r.color || "white",
      dimColor: r.dim || null,
      wrap: "truncate",
    }, r.text)
  );
  // indentasi tiap baris
  return h(Box, { flexDirection: "column" }, lines);
}

// ---- Main App ----
function App() {
  const { exit } = useApp();

  const [cfg, setCfg] = useState(loadConfig);
  const [running, setRunning] = useState(false);
  const [spawning, setSpawning] = useState(false);
  const [health, setHealth] = useState(null);
  const [logs, setLogs] = useState([]);        // full in-memory buffer
  const [logScroll, setLogScroll] = useState(0); // baris-render dari bawah
  const [showFullLog, setShowFullLog] = useState(false);
  const [reqCount, setReqCount] = useState(0);
  const [tokensIn, setTokensIn] = useState(0);
  const [tokensOut, setTokensOut] = useState(0);
  const [rtkSaved, setRtkSaved] = useState(0);
  const [rtkTotal, setRtkTotal] = useState(0);
  const [hist, setHist] = useState([]);
  const [modal, setModal] = useState(null);
  const [flash, setFlash] = useState(null);

  const serverRef = useRef(null);
  const healthTimerRef = useRef(null);
  const flashTimerRef = useRef(null);
  const logSeq = useRef(0);
  const logStack = useRef([]);
  const logColorRef = useRef(new Map()); // id -> {color,dimColor}
  const inputBuf = useRef("");

  // ---- helpers ----
  const setFlashMsg = useCallback(msg => {
    setFlash(msg);
    if (flashTimerRef.current) clearTimeout(flashTimerRef.current);
    flashTimerRef.current = setTimeout(() => setFlash(null), 4000);
  }, []);

  // Tambah log; terima (text, color). Bila color null, otomatis di-style.
  const addLog = useCallback((text, color) => {
    const id = ++logSeq.current;
    const styling = color ? { color } : styleLogLine(text);
    logColorRef.current.set(id, styling);
    const e = { id, time: new Date().toLocaleTimeString(), text };
    logStack.current.push(e);
    if (logStack.current.length > LOG_MAX) {
      const dropped = logStack.current.length - LOG_MAX;
      logStack.current = logStack.current.slice(-LOG_MAX);
      // bersihkan map warna untuk entri yang dibuang
      for (const d of logStack.current.slice(0, dropped)) logColorRef.current.delete(d.id);
    }
    setLogs([...logStack.current]);
    // Hapus scroll reset: biarkan posisi user (live atau sedang menggulir ke atas)
    // dipertahankan saat log baru masuk. Untuk kembali ke bawah, tekan G.
  }, []);

  const updateCfg = useCallback(updater => {
    setCfg(prev => {
      const next = typeof updater === "function" ? updater(prev) : updater;
      saveConfig(next);
      return next;
    });
  }, []);

  // ---- Server lifecycle ----
  const pollHealth = useCallback(() => {
    fetch(`http://localhost:${cfg.port}/health`)
      .then(r => { if (r.ok) return r.json(); return null; })
      .then(d => {
        if (!d) return null;
        setHealth(d);
        if (d.usage) {
          setReqCount(d.usage.requests);
          setTokensIn(d.usage.tokensIn);
          setTokensOut(d.usage.tokensOut);
          if (d.usage.rtkSavedBytes > 0) setRtkSaved(d.usage.rtkSavedBytes);
        }
        return d;
      })
      .catch(() => {});
  }, [cfg.port]);

  const startServer = useCallback(() => {
    if (serverRef.current) { setFlashMsg("Sudah running"); return; }
    if (!cfg.tokens.some(t => t.token)) { setFlashMsg("Set token dulu (t)"); return; }
    const tokenStr = cfg.tokens.map(t => `${t.name}:${t.token}`).join(",");
    setSpawning(true);
    const child = spawn(process.execPath, [join(__dirname, "../server.js")], {
      env: {
        ...process.env,
        AIP_TOKENS: tokenStr, PORT: String(cfg.port),
        RTK_ENABLED: String(cfg.rtkEnabled), RTK_TRUNCATE: String(cfg.rtkTruncate),
        CAVEMAN_ENABLED: String(cfg.cavemanEnabled), CAVEMAN_LEVEL: cfg.cavemanLevel,
        PONYTAIL_ENABLED: String(cfg.ponytailEnabled), HEADROOM_ENABLED: String(cfg.headroomEnabled),
        HEADROOM_THRESHOLD: String(cfg.headroomThreshold), DEFAULT_MAX_TOKENS: String(cfg.defaultMaxTokens),
      },
      cwd: join(__dirname, ".."), stdio: ["ignore", "pipe", "pipe"],
    });
    serverRef.current = child;

    child.stdout.on("data", d => {
      for (const line of d.toString().split("\n")) {
        const ln = line.trim();
        if (!ln) continue;
        if (ln.includes("[Token]")) { addLog(ln, "cyan"); continue; }
        if (ln.includes("[RTK]")) {
          const m = ln.match(/saved (\d+)B.*\(([\d.]+)%\)/);
          const saved = m ? parseInt(m[1], 10) : 0;
          if (saved > 0) {
            setRtkSaved(v => v + saved);
            setRtkTotal(v => v + saved / (parseFloat(m[2]) / 100));
          }
          addLog(ln, "green");
          continue;
        }
        // [req]/[done]/[token]/[Ingrazzio]/[error] — auto-styled
        addLog(ln);
      }
    });
    child.stderr.on("data", d => {
      for (const line of d.toString().split("\n")) {
        const ln = line.trim();
        if (!ln) continue;
        addLog(ln, "red");
      }
      // pertahankan log-error tambahan ke file server.log (legacy)
      const text = d.toString().trim();
      if (!text) return;
      const f = join(CONFIG_DIR, "server.log");
      try { writeFileSync(f, (existsSync(f) ? readFileSync(f, "utf8") : "") + text + "\n"); } catch {}
    });
    child.on("spawn", () => {
      setRunning(true); setSpawning(false);
      addLog("Server started", "green");
      setFlashMsg(`Server berjalan di :${cfg.port}`);
      healthTimerRef.current = setInterval(pollHealth, 2500);
    });
    child.on("exit", code => {
      serverRef.current = null;
      setRunning(false); setSpawning(false);
      if (healthTimerRef.current) { clearInterval(healthTimerRef.current); healthTimerRef.current = null; }
      addLog(`Server ${code === 0 ? "stopped" : `exited (${code})`}`, code === 0 ? "green" : "red");
      setFlashMsg(code === 0 ? "Server stopped" : `Server crash (${code})`);
    });
  }, [cfg, pollHealth, addLog, setFlashMsg]);

  const stopServer = useCallback(() => {
    if (!serverRef.current) { setFlashMsg("Tidak running"); return; }
    serverRef.current.kill("SIGTERM");
    addLog("Stopping…", "yellow");
  }, [addLog, setFlashMsg]);

  // Update history when token counters change
  useEffect(() => {
    setHist(prev => {
      if (prev.length === 0) return prev.concat({ t: Date.now(), in: tokensIn, out: tokensOut });
      const last = prev[prev.length - 1];
      if (last.in === tokensIn && last.out === tokensOut) return prev;
      const minusLast = prev.slice(0, -1);
      return minusLast.concat({ t: Date.now(), in: tokensIn, out: tokensOut }).slice(-HISTORY_MAX);
    });
  }, [tokensIn, tokensOut]);

  // Auto-start server pada mount jika token sudah dikonfigurasi
  const autoStarted = useRef(false);
  useEffect(() => {
    if (autoStarted.current) return;
    if (cfg.tokens.some(t => t.token)) {
      autoStarted.current = true;
      const id = setTimeout(startServer, 600);
      return () => clearTimeout(id);
    }
  }, [cfg, startServer]);

  // cleanup
  useEffect(() => () => {
    if (serverRef.current) serverRef.current.kill("SIGTERM");
    if (healthTimerRef.current) clearInterval(healthTimerRef.current);
  }, []);

  // ---- Keyboard ----
  useInput((input, key) => {
    if (key.ctrlC || key.escape) { exit(); return; }

    // --- Modal aktif: kunci huruf/digit/edit ---
    if (modal) {
      if (key.return) {
        const val = inputBuf.current.trim();
        if (modal?.type === "token") {
          if (val) {
            const name = modal.name;
            const i = cfg.tokens.findIndex(t => t.name === name);
            const clone = { ...cfg, tokens: cfg.tokens.map(t => ({ ...t })) };
            const idx = clone.tokens.findIndex(t => t.name === name);
            if (idx >= 0) clone.tokens[idx].token = val;
            else clone.tokens.push({ name, token: val });
            updateCfg(() => clone);
            setFlashMsg(`Token "${name}" ${val ? "diset" : "dikosongkan"}`);
          }
        } else if (modal?.type === "port") {
          const n = parseInt(val, 10);
          if (n > 0) { updateCfg(c => ({ ...c, port: n })); setFlashMsg(`Port → ${n}`); }
          else setFlashMsg("Port tidak valid");
        } else if (modal?.type === "caveman") {
          if (["lite", "full", "ultra"].includes(val)) { updateCfg(c => ({ ...c, cavemanLevel: val })); setFlashMsg(`Caveman → ${val}`); }
          else setFlashMsg("Level: lite/full/ultra");
        } else if (modal?.type === "maxtok") {
          const n = parseInt(val, 10);
          if (n > 0) { updateCfg(c => ({ ...c, defaultMaxTokens: n })); setFlashMsg(`max_tokens → ${n}`); }
          else setFlashMsg("Angka tidak valid");
        }
        inputBuf.current = "";
        setModal(null);
        return;
      }
      if (key.delete || key.backspace) inputBuf.current = inputBuf.current.slice(0, -1);
      else if (input && !key.ctrl && !key.meta && !key.escape && !key.tab && !key.return) inputBuf.current += input;
      return;
    }

    // --- Mode FULL LOG: F / Esc kembali, scroll bebas ---
    if (showFullLog) {
      if (input === "f" || input === "F" || key.escape || input === "q") { setShowFullLog(false); return; }
      // scroll log
      if (key.upArrow || input === "k") setLogScroll(s => Math.min(s + 1, 100000));
      else if (key.downArrow || input === "j") setLogScroll(s => Math.max(0, s - 1));
      else if (key.pageUp || input === "u") setLogScroll(s => Math.min(s + 20, 100000));
      else if (key.pageDown || input === "d") setLogScroll(s => Math.max(0, s - 20));
      else if (key.home || input === "g") setLogScroll(100000);
      else if (key.end || input === "G") setLogScroll(0);
      return;
    }

    // --- Dashboard: global keys ---
    if (input === "s" || input === "S") startServer();
    else if (input === "x" || input === "X") stopServer();
    else if (input === "f" || input === "F") setShowFullLog(true);
    else if (input === "t") { inputBuf.current = ""; setModal({ type: "token", name: "aip" }); }
    else if (input === "p") { inputBuf.current = ""; setModal({ type: "port" }); }
    else if (input === "c") { inputBuf.current = ""; setModal({ type: "caveman" }); }
    else if (input === "m") { inputBuf.current = ""; setModal({ type: "maxtok" }); }
    // scroll panel log (dashboard)
    else if (key.upArrow || input === "k") setLogScroll(s => Math.min(s + 1, 100000));
    else if (key.downArrow || input === "j") setLogScroll(s => Math.max(0, s - 1));
    else if (key.pageUp || input === "u") setLogScroll(s => Math.min(s + 20, 100000));
    else if (key.pageDown || input === "d") setLogScroll(s => Math.max(0, s - 20));
    else if (key.home || input === "g") setLogScroll(100000);
    else if (key.end || input === "G") setLogScroll(0);
    else if (input === "1") updateCfg(c => ({ ...c, rtkEnabled: !c.rtkEnabled }));
    else if (input === "2") updateCfg(c => ({ ...c, cavemanEnabled: !c.cavemanEnabled }));
    else if (input === "3") updateCfg(c => ({ ...c, ponytailEnabled: !c.ponytailEnabled }));
    else if (input === "4") updateCfg(c => ({ ...c, headroomEnabled: !c.headroomEnabled }));
    else if (input === "r") updateCfg(c => ({ ...c, rtkTruncate: !c.rtkTruncate }));
  }, { isActive: true });

  // ---- derived ----
  const breaker = health?.circuit;
  const hasToken = cfg.tokens.some(t => t.token);
  const statusColor = !running ? (spawning ? "yellow" : "gray")
    : breaker?.open ? "red" : health?.status === "degraded" ? "yellow" : "green";
  const statusWord = !running ? (spawning ? "spawning" : "stopped")
    : breaker?.open ? "CIRCUIT OPEN" : health?.status ?? "starting";

  const uptimeMin = health?.uptimeSec != null ? Math.round(health.uptimeSec / 60) : null;
  const junieV = health?.junie?.version;
  const sparkIn = hist.map(p => ({ value: p.in }));
  const sparkOut = hist.map(p => ({ value: p.out }));
  const rtkPct = rtkTotal > 0 ? ((rtkSaved / rtkTotal) * 100).toFixed(1) : null;

  // tinggi area log di mode full (layar penuh minus header/footer/flash)
  const fullLogHeight = Math.max(5, (process.stdout.rows || 24) - 4);

  // warna per id untuk LogView
  const cmap = {};
  for (const [id, st] of logColorRef.current) cmap[id] = st;

  // --- FULL LOG MODE: render seluruh layar sebagai log viewer ---
  if (showFullLog) {
    const fresh = logScroll === 0 ? true : (logScroll > 1 ? false : null);
    return h(Box, { flexDirection: "column", width: "100%" },
      h(Box, { height: 1, borderStyle: "round", borderColor: "cyan", paddingLeft: 1 },
        h(Text, { bold: true, color: "cyan" }, " FULL LOG "),
        h(Text, { dimColor: true }, ` ${logs.length} entri  `),
        h(Text, { color: logScroll > 0 ? "yellow" : "green" }, logScroll > 0 ? `▲ ${logScroll} baris ke atas` : "▶ live"),
        h(Text, { dimColor: true }, "   F/q/esc keluar   ↑↓/jk scroll   PgUp/PgDn/ud ±20   g home  G live")
      ),
      h(Box, { flexDirection: "column", width: "100%", height: fullLogHeight, paddingLeft: 0 },
        h(LogView, {
          entries: logs,
          height: fullLogHeight,
          width: Math.max(20, (process.stdout.columns || 80) - 2),
          scrollAt: logScroll,
          colorMap: cmap,
        })
      ),
      h(Box, { height: 1, paddingLeft: 1 },
        flash ? h(Text, { color: "yellow", bold: true }, ` ${flash}`) : h(Text, { dimColor: true }, "")
      )
    );
  }

  // --- DASHBOARD MODE ---
  return h(Box, { flexDirection: "column", width: "100%" },
    // Header
    h(Box, { height: 1, borderStyle: "round", borderColor: statusColor, paddingLeft: 1 },
      h(Text, { color: statusColor, bold: true }, " aip-router "),
      h(Text, {}, ` ${statusWord} `),
      h(Text, { dimColor: true }, `:${cfg.port}   up:${uptimeMin != null ? uptimeMin + "m" : "—"}   junie:${junieV || "?"}   tok:${cfg.tokens.filter(t => t.token).length}/${cfg.tokens.length}`)
    ),

    // Body (3 kolom: Status/Features | Tokens+Chart | Log)
    h(Box, { flexDirection: "row", width: "100%", height: LOG_PANEL_HEIGHT + 1, borderStyle: "round", borderColor: "gray" },

      // Kolom kiri — Status + Features
      h(Box, { flexDirection: "column", width: "36%", paddingLeft: 1, paddingTop: 1 },
        h(Text, { bold: true, color: "cyan" }, " Status"),
        h(Box, {}, h(Text, { dimColor: true }, "  Request:"), h(Text, { color: "yellow" }, ` ${reqCount}`)),
        h(Box, {}, h(Text, { dimColor: true }, "  Tokens in:"), h(Text, { color: "cyan" }, ` ${tokensIn.toLocaleString()}`)),
        h(Box, {}, h(Text, { dimColor: true }, "  Tokens out:"), h(Text, { color: "cyan" }, ` ${tokensOut.toLocaleString()}`)),
        h(Box, {}, h(Text, { dimColor: true }, "  RTK saved:"), h(Text, { color: "green" }, ` ${rtkSaved.toLocaleString()}B${rtkPct ? ` (${rtkPct}%)` : ""}`)),
        breaker && h(Box, {},
          h(Text, { dimColor: true }, "  Circuit:"),
          h(Text, { bold: true, color: breaker.open ? "red" : "green" }, breaker.open ? " OPEN" : " closed"),
          h(Text, { dimColor: true }, ` fail=${breaker.failures}/5 req=${breaker.totalRequests}${breaker.reopenInMs ? ` reopen:${Math.round(breaker.reopenInMs / 1000)}s` : ""}`)
        ),
        h(Box, {}, h(Text, { dimColor: true }, "  Health:"), h(Text, { color: health?.status === "degraded" ? "yellow" : "green" }, ` ${health?.status ?? "n/a"}`)),

        h(Text, {}, " "),
        h(Text, { bold: true, color: "cyan" }, " Features"),
        h(ToggleRow, { label: "rtk", on: cfg.rtkEnabled }),
        h(ToggleRow, { label: "rtkTrunc", on: cfg.rtkTruncate }),
        h(ToggleRow, { label: "caveman", on: cfg.cavemanEnabled, detail: cfg.cavemanEnabled ? `[${cfg.cavemanLevel}]` : null, color: "magenta" }),
        h(ToggleRow, { label: "ponytail", on: cfg.ponytailEnabled }),
        h(ToggleRow, { label: "headroom", on: cfg.headroomEnabled, detail: cfg.headroomEnabled ? `[${cfg.headroomThreshold}%]` : null }),
        h(Box, {}, h(Text, { dimColor: true }, "  max_tok:"), h(Text, { color: "cyan" }, ` ${cfg.defaultMaxTokens}`))
      ),

      // Kolom tengah — Tokens + Chart
      h(Box, { flexDirection: "column", width: "26%", paddingLeft: 1, paddingTop: 1 },
        h(Text, { bold: true, color: "cyan" }, " Tokens"),
        cfg.tokens.length === 0
          ? h(Text, { dimColor: true }, "  (kosong — tekan t)")
          : cfg.tokens.map(t => {
              const cool = health?.tokens?.find(tk => tk.name === t.name)?.cooldown || 0;
              const state = !t.token
                ? h(Text, { color: "red" }, " ✗ kosong")
                : cool > 0
                  ? h(Text, { color: "yellow" }, ` ⧗ cooldown ${(cool / 1000).toFixed(0)}s`)
                  : h(Text, { color: "green" }, " ✓ active");
              return h(Box, { key: t.name }, h(Text, {}, `  ${t.name}`), state);
            }),

        h(Text, {}, " "),
        h(Text, { bold: true, color: "cyan" }, " Token usage / 1m"),
        h(Box, { flexDirection: "row" },
          h(Box, { flexDirection: "column", width: "50%" },
            h(Text, { dimColor: true }, " in"),
            h(Sparkline, { data: sparkIn, color: "cyan" })
          ),
          h(Box, { flexDirection: "column", width: "50%" },
            h(Text, { dimColor: true }, " out"),
            h(Sparkline, { data: sparkOut, color: "green" })
          )
        )
      ),

      // Kolom kanan — Log (scrollable, wrap, tidak terpotong)
      h(Box, { flexDirection: "column", width: "38%", paddingLeft: 1, paddingTop: 1 },
        h(Box, {},
          h(Text, { bold: true, color: "cyan" }, " Log "),
          h(Text, { dimColor: true }, `(${logs.length})`),
          logScroll > 0
            ? h(Text, { color: "yellow" }, ` ▲${logScroll}`)
            : h(Text, { dimColor: true }, " ●"),
          h(Text, { dimColor: true }, "  F↕")
        ),
        h(LogView, {
          entries: logs,
          height: LOG_PANEL_HEIGHT,
          width: Math.max(24, (process.stdout.columns ? Math.floor(process.stdout.columns * 0.38) : 42) - 2),
          scrollAt: logScroll,
          colorMap: cmap,
        })
      )
    ),

    // Modal editor
    modal && h(Box, { borderStyle: "double", borderColor: "magenta", paddingLeft: 1, height: 3, flexDirection: "column", justifyContent: "center" },
      h(Text, { bold: true }, ` ${modalPrompt(modal)} `),
      h(Text, { color: "cyan" }, `  ${inputBuf.current}█`)
    ),

    // Status/flash line
    h(Box, { height: 1, paddingLeft: 1 },
      flash
        ? h(Text, { color: "yellow", bold: true }, ` ${flash}`)
        : spawning
          ? h(Box, {}, h(Spinner, { type: "dots" }), h(Text, { dimColor: true }, " menerbitkan server…"))
          : h(Text, { dimColor: true }, "")
    ),

    // Footer keymap
    h(Box, { paddingLeft: 1, borderStyle: "round", borderColor: "gray" },
      h(Text, { dimColor: true },
        ` s start  x stop  F full-log  ↑↓/jk scroll  g/G home/live  t token  p port  c caveman  m max_tok  1-4 toggles  r trunc  q quit`)
    )
  );
}

function modalPrompt(m) {
  if (m.type === "token") return `Token untuk "${m.name}" →`;
  if (m.type === "port") return "Port baru →";
  if (m.type === "caveman") return "Caveman level (lite/full/ultra) →";
  if (m.type === "maxtok") return "Default max_tokens (2048) →";
  return "→";
}

// ---- Auto-start jika token sudah dikonfig & server belum jalan ----
render(h(App), { exitOnCtrlC: false });