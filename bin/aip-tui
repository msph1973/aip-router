#!/usr/bin/env node
/**
 * aip-tui — AIP Router dashboard (Ink/React rewrite)
 *
 * Desain ulang: log panel kini KOMPREHENSIF & TIDAK TERPOTONG.
 *  - Buffer in-memory besar (2000 entri).
 *  - Panel dapat di-scroll (k/j/↑/↓, PgUp/PgDn, g/G home/end).
 *  - Mode FULL LOG (F): seluruh layar jadi log viewer; panjang di-wrap penuh,
 *    tidak ada teks yang dipotong.
 *  - Setiap baris log diwarnai berdasarkan konten ([req]/[done]/[token]/[RTK]/
 *    error), mencerminkan struktur log server (stdout + JSONL di
 *    ~/.aip-router/router.jsonl).
 *
 * Teknis: tanpa build step — JSX ditulis sebagai react.createElement.
 * Styling memakai props React (color/bold), BUKAN ANSI escape literal.
 */
import React, { useState, useEffect, useRef, useCallback } from "react";
import { render, Box, Text, useApp, useInput } from "ink";
import { Badge, TextInput, Select } from "@inkjs/ui";
import Spinner from "ink-spinner";
import { spawn } from "child_process";
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "fs";
import { homedir } from "os";
import { join, dirname } from "path";
import { fileURLToPath } from "url";

const __dirname = dirname(fileURLToPath(import.meta.url));
const CONFIG_DIR = join(homedir(), ".aip-router");
const CONFIG_PATH = join(CONFIG_DIR, "config.json");

// ---- Config helpers ----
function loadConfig() {
  const base = existsSync(CONFIG_PATH)
    ? JSON.parse(readFileSync(CONFIG_PATH, "utf8"))
    : {};
  return {
    tokens: base.tokens || [],
    port: base.port || 20129,
    rtkEnabled: base.rtkEnabled !== false,
    cavemanEnabled: base.cavemanEnabled === true,
    cavemanLevel: base.cavemanLevel || "full",
    ponytailEnabled: base.ponytailEnabled === true,
    headroomEnabled: base.headroomEnabled === true,
    headroomThreshold: base.headroomThreshold || 80,
    defaultMaxTokens: base.defaultMaxTokens || 2048,
    rtkTruncate: base.rtkTruncate !== false,
  };
}
function saveConfig(cfg) {
  if (!existsSync(CONFIG_DIR)) mkdirSync(CONFIG_DIR, { recursive: true });
  writeFileSync(CONFIG_PATH, JSON.stringify(cfg, null, 2));
}

// h() = JSX tanpa build step
const h = React.createElement;

const LOG_MAX = 2000; // entri log maksimum yang disimpan dalam buffer

// ---- Theme terpusat (pola darkTheme dari kamlesh723/InkUI, tanpa library tambahan) ----
// Seluruh komponen render memakai token di bawah — ganti warna DI SINI satu kali
// untuk mengubah palette seluruh TUI. Nilai bisa nama warna Ink (green, yellow…)
// atau hex 24-bit (#rrggbb — didukung Ink 7).
const THEME = {
  colors: {
    primary:   "#d45bff",   // aksen utama — judul panel, modal, fokus
    secondary: "#4dd7ff",   // data sekunder — token/junie/angka in-out
    success:   "#3ddc84",   // ON / healthy / token hidup / circuit closed
    warning:   "#ffc53d",   // cooldown, degraded, flash, indikator scroll
    error:     "#ff5c6a",   // token ✗ / circuit open / log error
    info:      "#4aa8ff",   // info umum
    muted:     "#6b7482",   // border, teks redup, badge OFF
    text:      "#f2f5fa",
    textInverse: "#0b0e14",
    border:    "#3a4152",   // border log panel / full-log
    focus:     "#d45bff",
  },
};
const C = THEME.colors; // pintasan ringkas

// ---- Styling log berdasarkan konten (mencocokkan struktur log server) ----
// Prioritas: baris-error selalu merah; token cyan; RTK hijau; done putih;
// req cyan-baru; sisanya putih.
function styleLogLine(text) {
  const t = text;
  const isErr =
    /\[error\]|\[warn\]|threw:|failed:|Exception|Unauthorized|Too Many Requests|Bad Request|Internal Server Error|ReferenceError|circuit open/i.test(t);
  if (isErr) return { color: C.error };
  if (t.includes("[token]")) return { color: C.secondary };
  if (t.includes("[RTK]")) return { color: C.success };
  if (t.includes("[done]")) return { color: C.text };
  if (t.includes("[req]")) return { color: C.info };
  if (t.startsWith("[Ingrazzio]")) return { color: C.warning };
  return { color: C.text, dimColor: true };
}
// ---- Multi-line wrapped log viewer ----
// Menampilkan entri log; teks panjang di-wrap penuh (tidak terpotong).
// `width` menentukan lebar kolom teks; `height` membatasi tinggi viewport.
// `scrollAt` = offset baris-render dari bawah (0 = paling baru).
// Bangun daftar "baris render" (entri log yang sudah di-wrap ke lebar kolom).
// Dipakai bersama oleh LogView (render) dan geometri scroll (clamp offset).
function buildLogRows(entries, width, colorMap) {
  const w = Math.max(1, width);
  const rows = [];
  for (const e of entries) {
    const st = colorMap ? colorMap[e.id] : null;
    const t = `${e.time} ${e.text}`.trim();
    if (t.length === 0) { rows.push({ e, text: "", color: st?.color, dim: st?.dimColor }); continue; }
    for (let i = 0; i < t.length; i += w) {
      rows.push({ e, text: t.slice(i, i + w), color: st?.color, dim: st?.dimColor });
    }
  }
  return rows;
}

function LogView({ entries, height, width, scrollAt = 0, colorMap, geomRef }) {
  const renderRows = entries.length ? buildLogRows(entries, width, colorMap) : [];

  // Publikasikan geometri aktual (total baris render + tinggi viewport) supaya
  // handler keyboard bisa membatasi offset scroll — tanpa ini offset bisa
  // melesat jauh melebihi jumlah baris dan scroll terasa "macet".
  if (geomRef) geomRef.current = { total: renderRows.length, height, width };

  if (!entries.length) return h(Text, { dimColor: true }, "  (belum ada log)");

  // scrollAt dalam jumlah baris-render dari bawah; clamp agar tidak keluar batas
  const total = renderRows.length;
  const maxScroll = Math.max(0, total - height);
  const off = Math.min(Math.max(0, scrollAt), maxScroll);
  const from = Math.max(0, total - off - height);
  const to = Math.min(total, from + height);
  const visible = renderRows.slice(from, to);

  const lines = visible.map((r, i) =>
    h(Text, {
      key: `${r.e.id}-${i}`,
      color: r.color || C.text,
      dimColor: r.dim || null,
      wrap: "truncate",
    }, r.text)
  );
  // Pad dengan baris kosong hingga viewport penuh agar panel selalu rapi (tidak ada lubang)
  while (lines.length < height) lines.push(h(Text, { key: `pad-${lines.length}` }, ""));
  // indentasi tiap baris
  return h(Box, { flexDirection: "column" }, lines);
}

// ---- Main App ----
function App() {
  const { exit } = useApp();

  const [cfg, setCfg] = useState(loadConfig);
  const [running, setRunning] = useState(false);
  const [spawning, setSpawning] = useState(false);
  const [health, setHealth] = useState(null);
  const [logs, setLogs] = useState([]);        // full in-memory buffer
  const [logScroll, setLogScroll] = useState(0); // baris-render dari bawah
  const [showFullLog, setShowFullLog] = useState(false);
  const [reqCount, setReqCount] = useState(0);
  const [tokensIn, setTokensIn] = useState(0);
  const [tokensOut, setTokensOut] = useState(0);
  const [rtkSaved, setRtkSaved] = useState(0);
  const [rtkTotal, setRtkTotal] = useState(0);
  const [modal, setModal] = useState(null);
  const [flash, setFlash] = useState(null);

  const serverRef = useRef(null);
  const healthTimerRef = useRef(null);
  const flashTimerRef = useRef(null);
  const logSeq = useRef(0);
  const logStack = useRef([]);
  const logColorRef = useRef(new Map()); // id -> {color,dimColor}
  const inputBuf = useRef("");
  // Geometri log yang sedang tampil — diisi oleh LogView tiap render:
  // { total: jumlah baris-render, height: tinggi viewport }.
  const logGeom = useRef({ total: 0, height: 10 });

  // Scroll log dengan clamp ke batas nyata (0 .. total-height).
  // delta > 0 = ke atas (lebih tua), delta < 0 = ke bawah (lebih baru).
  const scrollLog = useCallback(delta => {
    setLogScroll(s => {
      const g = logGeom.current || { total: 0, height: 10 };
      const max = Math.max(0, g.total - g.height);
      return Math.min(Math.max(0, s + delta), max);
    });
  }, []);
  const scrollLogTop = useCallback(() => {
    const g = logGeom.current || { total: 0, height: 10 };
    setLogScroll(Math.max(0, g.total - g.height));
  }, []);

  // ---- helpers ----
  const setFlashMsg = useCallback(msg => {
    setFlash(msg);
    if (flashTimerRef.current) clearTimeout(flashTimerRef.current);
    flashTimerRef.current = setTimeout(() => setFlash(null), 4000);
  }, []);

  // Tambah log; terima (text, color). Bila color null, otomatis di-style.
  const addLog = useCallback((text, color) => {
    const id = ++logSeq.current;
    const styling = color ? { color } : styleLogLine(text);
    logColorRef.current.set(id, styling);
    const e = { id, time: new Date().toLocaleTimeString(), text };
    logStack.current.push(e);
    if (logStack.current.length > LOG_MAX) {
      const dropped = logStack.current.length - LOG_MAX;
      logStack.current = logStack.current.slice(-LOG_MAX);
      // bersihkan map warna untuk entri yang dibuang
      for (const d of logStack.current.slice(0, dropped)) logColorRef.current.delete(d.id);
    }
    // Bila user sedang menggulir ke atas (offset > 0), naikkan offset sebanyak
    // baris-render yang baru masuk agar konten yang sedang dibaca tetap diam
    // di tempat (anchored). Offset 0 = live, biarkan mengikuti log terbaru.
    setLogScroll(s => {
      if (s <= 0) return 0;
      const w = Math.max(1, logGeom.current?.width || 80);
      const full = `${e.time} ${e.text}`.trim();
      const addedRows = Math.max(1, Math.ceil(full.length / w));
      return s + addedRows;
    });
    setLogs([...logStack.current]);
    // Hapus scroll reset: biarkan posisi user (live atau sedang menggulir ke atas)
    // dipertahankan saat log baru masuk. Untuk kembali ke bawah, tekan G.
  }, []);

  const updateCfg = useCallback(updater => {
    setCfg(prev => {
      const next = typeof updater === "function" ? updater(prev) : updater;
      saveConfig(next);
      return next;
    });
  }, []);

  // ---- Server lifecycle ----
  const pollHealth = useCallback(() => {
    fetch(`http://localhost:${cfg.port}/health`)
      .then(r => { if (r.ok) return r.json(); return null; })
      .then(d => {
        if (!d) return null;
        setHealth(d);
        if (d.usage) {
          setReqCount(d.usage.requests);
          setTokensIn(d.usage.tokensIn);
          setTokensOut(d.usage.tokensOut);
          if (d.usage.rtkSavedBytes > 0) setRtkSaved(d.usage.rtkSavedBytes);
        }
        return d;
      })
      .catch(() => {});
  }, [cfg.port]);

  // Refresh token account probes on demand — dipanggil tombol "a".
  const refreshAccounts = useCallback(() => {
    fetch(`http://localhost:${cfg.port}/v1/accounts/refresh`, { method: "POST" })
      .then(r => r.json())
      .then(d => { if (d?.ok) setFlashMsg("Akun token di-refresh"); })
      .catch(() => setFlashMsg("Gagal refresh akun"));
  }, [cfg.port]);

  const startServer = useCallback(() => {
    if (serverRef.current) { setFlashMsg("Sudah running"); return; }
    if (!cfg.tokens.some(t => t.token)) { setFlashMsg("Set token dulu (t)"); return; }
    const tokenStr = cfg.tokens.map(t => `${t.name}:${t.token}`).join(",");
    setSpawning(true);
    const child = spawn(process.execPath, [join(__dirname, "../server.js")], {
      env: {
        ...process.env,
        AIP_TOKENS: tokenStr, PORT: String(cfg.port),
        RTK_ENABLED: String(cfg.rtkEnabled), RTK_TRUNCATE: String(cfg.rtkTruncate),
        CAVEMAN_ENABLED: String(cfg.cavemanEnabled), CAVEMAN_LEVEL: cfg.cavemanLevel,
        PONYTAIL_ENABLED: String(cfg.ponytailEnabled), HEADROOM_ENABLED: String(cfg.headroomEnabled),
        HEADROOM_THRESHOLD: String(cfg.headroomThreshold), DEFAULT_MAX_TOKENS: String(cfg.defaultMaxTokens),
      },
      cwd: join(__dirname, ".."), stdio: ["ignore", "pipe", "pipe"],
    });
    serverRef.current = child;

    child.stdout.on("data", d => {
      for (const line of d.toString().split("\n")) {
        const ln = line.trim();
        if (!ln) continue;
        if (ln.includes("[Token]")) { addLog(ln, C.secondary); continue; }
        if (ln.includes("[RTK]")) {
          const m = ln.match(/saved (\d+)B.*\(([\d.]+)%\)/);
          const saved = m ? parseInt(m[1], 10) : 0;
          if (saved > 0) {
            setRtkSaved(v => v + saved);
            setRtkTotal(v => v + saved / (parseFloat(m[2]) / 100));
          }
          addLog(ln, C.success);
          continue;
        }
        // [req]/[done]/[token]/[Ingrazzio]/[error] — auto-styled
        addLog(ln);
      }
    });
    child.stderr.on("data", d => {
      for (const line of d.toString().split("\n")) {
        const ln = line.trim();
        if (!ln) continue;
        addLog(ln, C.error);
      }
      // pertahankan log-error tambahan ke file server.log (legacy)
      const text = d.toString().trim();
      if (!text) return;
      const f = join(CONFIG_DIR, "server.log");
      try { writeFileSync(f, (existsSync(f) ? readFileSync(f, "utf8") : "") + text + "\n"); } catch {}
    });
    child.on("spawn", () => {
      setRunning(true); setSpawning(false);
      addLog("Server started", C.success);
      setFlashMsg(`Server berjalan di :${cfg.port}`);
      healthTimerRef.current = setInterval(pollHealth, 2500);
    });
    child.on("exit", code => {
      serverRef.current = null;
      setRunning(false); setSpawning(false);
      if (healthTimerRef.current) { clearInterval(healthTimerRef.current); healthTimerRef.current = null; }
      addLog(`Server ${code === 0 ? "stopped" : `exited (${code})`}`, code === 0 ? C.success : C.error);
      setFlashMsg(code === 0 ? "Server stopped" : `Server crash (${code})`);
    });
  }, [cfg, pollHealth, addLog, setFlashMsg]);

  const stopServer = useCallback(() => {
    if (!serverRef.current) { setFlashMsg("Tidak running"); return; }
    serverRef.current.kill("SIGTERM");
    addLog("Stopping…", C.warning);
  }, [addLog, setFlashMsg]);

  // Auto-start server pada mount jika token sudah dikonfigurasi
  const autoStarted = useRef(false);
  useEffect(() => {
    if (autoStarted.current) return;
    if (cfg.tokens.some(t => t.token)) {
      autoStarted.current = true;
      const id = setTimeout(startServer, 600);
      return () => clearTimeout(id);
    }
  }, [cfg, startServer]);

  // cleanup
  useEffect(() => () => {
    if (serverRef.current) serverRef.current.kill("SIGTERM");
    if (healthTimerRef.current) clearInterval(healthTimerRef.current);
  }, []);

  // ---- Keyboard ----
  useInput((input, key) => {
    if (key.ctrlC || key.escape) { exit(); return; }

    // --- Modal aktif: serahkan input ke komponen @inkjs/ui (TextInput/Select).
    // Jangan proses apapun di sini, biar komponen itu yang menangkap stdin penuh.
    if (modal) return;

    // --- Mode FULL LOG: F / Esc kembali, scroll bebas ---
    if (showFullLog) {
      if (input === "f" || input === "F" || key.escape || input === "q") { setShowFullLog(false); return; }
      // scroll log (clamp ke batas nyata via logGeom)
      if (key.upArrow || input === "k") scrollLog(+1);
      else if (key.downArrow || input === "j") scrollLog(-1);
      else if (key.pageUp || input === "u") scrollLog(+Math.max(1, (logGeom.current?.height || 10) - 1));
      else if (key.pageDown || input === "d") scrollLog(-Math.max(1, (logGeom.current?.height || 10) - 1));
      else if (key.home || input === "g") scrollLogTop();
      else if (key.end || input === "G") setLogScroll(0);
      return;
    }

    // --- Dashboard: global keys ---
    if (input === "s" || input === "S") startServer();
    else if (input === "x" || input === "X") stopServer();
    else if (input === "f" || input === "F") setShowFullLog(true);
    else if (input === "a" || input === "A") { if (running) refreshAccounts(); else setFlashMsg("Server belum running"); }
    else if (input === "t") { inputBuf.current = ""; setModal({ type: "token", name: "aip" }); }
    else if (input === "p") { inputBuf.current = ""; setModal({ type: "port" }); }
    else if (input === "c") { inputBuf.current = ""; setModal({ type: "caveman" }); }
    else if (input === "m") { inputBuf.current = ""; setModal({ type: "maxtok" }); }
    // scroll panel log (dashboard) — clamp ke batas nyata via logGeom
    else if (key.upArrow || input === "k") scrollLog(+1);
    else if (key.downArrow || input === "j") scrollLog(-1);
    else if (key.pageUp || input === "u") scrollLog(+Math.max(1, (logGeom.current?.height || 10) - 1));
    else if (key.pageDown || input === "d") scrollLog(-Math.max(1, (logGeom.current?.height || 10) - 1));
    else if (key.home || input === "g") scrollLogTop();
    else if (key.end || input === "G") setLogScroll(0);
    else if (input === "1") {
      const nv = !cfg.rtkEnabled;
      updateCfg(c => ({ ...c, rtkEnabled: nv }));
      addLog(`[Toggle] RTK ${nv ? "ON" : "OFF"}`, nv ? C.success : C.warning);
    }
    else if (input === "2") {
      const nv = !cfg.cavemanEnabled;
      updateCfg(c => ({ ...c, cavemanEnabled: nv }));
      addLog(`[Toggle] Caveman ${nv ? "ON" : "OFF"}`, nv ? C.success : C.warning);
    }
    else if (input === "3") {
      const nv = !cfg.ponytailEnabled;
      updateCfg(c => ({ ...c, ponytailEnabled: nv }));
      addLog(`[Toggle] Ponytail ${nv ? "ON" : "OFF"}`, nv ? C.success : C.warning);
    }
    else if (input === "4") {
      const nv = !cfg.headroomEnabled;
      updateCfg(c => ({ ...c, headroomEnabled: nv }));
      addLog(`[Toggle] Headroom ${nv ? "ON" : "OFF"}`, nv ? C.success : C.warning);
    }
    else if (input === "r") {
      const nv = !cfg.rtkTruncate;
      updateCfg(c => ({ ...c, rtkTruncate: nv }));
      addLog(`[Toggle] RTK-truncate ${nv ? "ON" : "OFF"}`, nv ? C.success : C.warning);
    }
  }, { isActive: true });

  // ---- derived ----
  const breaker = health?.circuit;
  const hasToken = cfg.tokens.some(t => t.token);
  const statusColor = !running ? (spawning ? C.warning : C.muted)
    : breaker?.open ? C.error : health?.status === "degraded" ? C.warning : C.success;
  const statusWord = !running ? (spawning ? "spawning" : "stopped")
    : breaker?.open ? "CIRCUIT OPEN" : health?.status ?? "starting";

  const uptimeMin = health?.uptimeSec != null ? Math.round(health.uptimeSec / 60) : null;
  const junieV = health?.junie?.version;
  const rtkPct = rtkTotal > 0 ? ((rtkSaved / rtkTotal) * 100).toFixed(1) : null;

  // warna per id untuk LogView
  const cmap = {};
  for (const [id, st] of logColorRef.current) cmap[id] = st;

  // --- FULL LOG MODE: render seluruh layar sebagai log viewer (clean) ---
    if (showFullLog) {
      const bodyH = Math.max(5, (process.stdout.rows || 24) - 5);
      const gTot = logGeom.current?.total || 0;
      const gMax = Math.max(0, gTot - bodyH);
      return h(Box, { flexDirection: "column", width: "100%", borderStyle: "round", borderColor: C.border },
        h(Box, { height: 1, paddingLeft: 1, borderBottom: true, borderColor: C.border },
          h(Text, { bold: true, color: C.primary }, " FULL LOG "),
          h(Text, { dimColor: true }, `(${logs.length} entri · ${gTot} baris)  `),
          h(Text, { color: logScroll > 0 ? C.warning : C.success },
            logScroll > 0 ? `▲ ${logScroll}/${gMax}` : "● live"),
          h(Text, { dimColor: true }, "   ↑↓/jk 1 baris  u/d ½ layar  g awal  G live  F/esc keluar")
        ),
        h(Box, { flexDirection: "column", height: bodyH, paddingLeft: 1 },
          h(LogView, { entries: logs, height: bodyH, width: Math.max(30, (process.stdout.columns || 80) - 4), scrollAt: logScroll, colorMap: cmap, geomRef: logGeom })
        ),
        h(Box, { height: 1, paddingLeft: 1, borderTop: true, borderColor: C.border },
          flash ? h(Text, { color: C.warning, bold: true }, ` ${flash}`) : h(Text, { dimColor: true }, "")
        )
      );
    }

    // --- DASHBOARD MODE ---
    // Baris tetap: header(status) 1 + metric-row 1 + flash 1 + footer 2 = 5.
    // Ruang tersisa (minus slop) untuk log panel.
    const footH = 2;   // 2 baris teks footer (keymap + toggle) — TANPA border box
    const fixedH = 1 + 1 + 1 + 1 + footH; // header + metric + token row + flash + footer
    const logH = Math.min(24, Math.max(5, (process.stdout.rows || 24) - fixedH - 2));

    // badge warna per kondisi
    const circuitBadge = breaker?.open ? C.error : health?.status === "degraded" ? C.warning : C.success;
    const tokOn = cfg.tokens.filter(t => t.token).length;
    // Lebar akun dibatasi oleh lebar terminal dibagi jumlah token: metric row
    // dulu menampung ini dan meluber, memotong nama token sendiri. Sekarang
    // token punya barisnya sendiri sehingga akun bisa tampil (hampir) penuh.
    const acctMax = Math.max(8, Math.floor(((process.stdout.columns || 80) - 12) / Math.max(1, cfg.tokens.length)) - 8);
    const tokenBadges = cfg.tokens.map(t => {
      const ht = health?.tokens?.find(tk => tk.name === t.name) || {};
      const cool = ht.cooldown || 0;
      const st = !t.token ? { label: "✗", color: C.error }
        : cool > 0 ? { label: `⧗${(cool / 1000).toFixed(0)}s`, color: C.warning }
          : ht.valid === false ? { label: "✗", color: C.error }
            : ht.valid === true ? { label: "●", color: C.success }
              : { label: "?", color: C.muted }; // belum/ tidak konklusif diprobe
      const acct = ht.account
        ? (ht.account.length > acctMax ? ht.account.slice(0, acctMax) + "…" : ht.account)
        : null;
      const acctColor = ht.valid === false ? C.error : ht.valid === true ? C.secondary : C.muted;
      return h(Box, { key: t.name, flexDirection: "row", flexShrink: 0 },
        h(Text, { bold: true }, ` ${t.name} `),
        h(Badge, { color: st.color }, st.label),
        acct ? h(Text, { dimColor: true, color: acctColor }, ` ${acct}`) : null);
    });

    return h(Box, { flexDirection: "column", width: "100%" },
      // ── Header: satu baris status (warna berubah mengikuti state) ──
      h(Box, { flexDirection: "row", paddingLeft: 0 },
        h(Text, { color: statusColor, bold: true }, " aip-router "),
        h(Badge, { color: statusColor }, statusWord),
        h(Text, { dimColor: true },
          ` :${cfg.port}  up ${uptimeMin != null ? uptimeMin + "m" : "—"}  junie ${junieV || "?"}  tok ${tokOn}/${cfg.tokens.length}`)
      ),

      // ── Baris metric: counter + circuit + health (tanpa token) ──
      h(Box, { flexDirection: "row", marginTop: 0 },
        h(Text, { dimColor: true }, " req "), h(Text, { color: C.warning, bold: true }, `${reqCount}`),
        h(Text, { dimColor: true }, "   in "), h(Text, { color: C.secondary }, `${tokensIn.toLocaleString()}`),
        h(Text, { dimColor: true }, "   out "), h(Text, { color: C.secondary }, `${tokensOut.toLocaleString()}`),
        h(Text, { dimColor: true }, "   rtk "), h(Text, { color: C.success }, `${rtkSaved.toLocaleString()}B${rtkPct ? ` (${rtkPct}%)` : ""}`),
        h(Text, { dimColor: true }, "   circuit "), h(Badge, { color: circuitBadge }, breaker?.open ? "OPEN" : "closed"),
        h(Text, { dimColor: true }, "   health "),
        h(Badge, { color: health?.status === "degraded" ? C.warning : C.success }, health?.status ?? "n/a")
      ),

      // ── Baris token: nama + validitas + akun (baris sendiri agar akun muat) ──
      h(Box, { flexDirection: "row", marginTop: 0 },
        h(Text, { dimColor: true }, " akun"),
        ...tokenBadges
      ),

      // ── Log panel — dominan, scrollable, tidak terpotong ──
      h(Box, { flexDirection: "column", borderStyle: "round", borderColor: C.border, height: logH + 2 },
        h(Box, { height: 1, paddingLeft: 1, borderBottom: true, borderColor: C.border },
          h(Text, { bold: true, color: C.primary }, " LOG "),
          h(Text, { dimColor: true }, `(${logs.length} entri · ${logGeom.current?.total || 0} baris)`),
          h(Text, { color: logScroll > 0 ? C.warning : C.success },
            logScroll > 0
              ? `  ▲ ${logScroll}/${Math.max(0, (logGeom.current?.total || 0) - logH)}`
              : "  ● live"),
          h(Text, { dimColor: true }, "   ↑↓/jk 1  u/d ½  g awal  G live  F full")
        ),
        h(Box, { flexDirection: "column", height: logH, paddingLeft: 1 },
          h(LogView, {
            entries: logs,
            height: logH,
            width: Math.max(30, (process.stdout.columns || 80) - 4),
            scrollAt: logScroll,
            colorMap: cmap,
            geomRef: logGeom,
          })
        )
      ),

      // Modal editor — @inkjs/ui (TextInput/Select) menggantikan overlay manual
      modal && h(Box, { borderStyle: "round", borderColor: C.primary, flexDirection: "column", padding: 1, marginTop: 1 },
        h(Text, { bold: true, color: C.primary }, ` ${modalPrompt(modal)} `),
        h(ModalEditor, {
          m: modal,
          cfg,
          updateCfg,
          onCommit: () => setModal(null),
          onFlash: setFlashMsg,
        })
      ),

      // Status/flash line
      h(Box, { height: 1, paddingLeft: 1, marginTop: modal ? 0 : 1 },
        flash
          ? h(Text, { color: C.warning, bold: true }, ` ${flash}`)
          : spawning
            ? h(Box, {}, h(Spinner, { type: "dots" }), h(Text, { dimColor: true }, " menerbitkan server…"))
            : h(Text, { dimColor: true }, "")
      ),

      // ── Footer: baris keymap + baris toggle (badge, tanpa border box) ──
      h(Box, { flexDirection: "column", paddingLeft: 1 },
        h(Text, { dimColor: true }, " s/x start  a akun  F full  t token  p port  c caveman-lvl  m max_tok   ↑↓/jk scroll  g home  G live  q quit"),
        h(Box, { flexDirection: "row" },
          h(Text, { dimColor: true }, " toggles: "),
          h(Badge, { color: cfg.rtkEnabled ? C.success : C.muted }, `1 rtk ${cfg.rtkEnabled ? "ON" : "OFF"}`),
          h(Text, {}, " "),
          h(Badge, { color: cfg.cavemanEnabled ? C.success : C.muted }, `2 cav ${cfg.cavemanEnabled ? "ON" : "OFF"}`),
          h(Text, {}, " "),
          h(Badge, { color: cfg.ponytailEnabled ? C.success : C.muted }, `3 pon ${cfg.ponytailEnabled ? "ON" : "OFF"}`),
          h(Text, {}, " "),
          h(Badge, { color: cfg.headroomEnabled ? C.success : C.muted }, `4 head ${cfg.headroomEnabled ? "ON" : "OFF"}`),
          h(Text, {}, " "),
          h(Badge, { color: cfg.rtkTruncate ? C.success : C.muted }, `r trunc ${cfg.rtkTruncate ? "ON" : "OFF"}`)
        )
      )
    );
}

function ModalEditor({ m, cfg, updateCfg, onCommit, onFlash }) {
  // Komponen @inkjs/ui interaktif yang menangkap stdin saat modal terbuka.
  // useInput di App sudah nonaktif (guard `if (modal) return`), jadi fokus
  // komponen ini sepenuhnya.
  const commit = onCommit;

  if (m.type === "port" || m.type === "maxtok") {
    return h(TextInput, {
      placeholder: m.type === "port" ? "port baru (angka)…" : "default max_tokens (angka)…",
      defaultValue: "",
      onSubmit: val => {
        const n = parseInt(val.trim(), 10);
        if (n > 0) {
          updateCfg(c => ({ ...c, [m.type === "port" ? "port" : "defaultMaxTokens"]: n }));
          onFlash(`${m.type === "port" ? "Port" : "max_tokens"} → ${n}`);
        } else onFlash("Angka tidak valid");
        commit();
      },
    });
  }

  if (m.type === "caveman") {
    return h(Select, {
      options: [
        { label: "lite", value: "lite" },
        { label: "full", value: "full" },
        { label: "ultra", value: "ultra" },
      ],
      onChange: val => { updateCfg(c => ({ ...c, cavemanLevel: val })); onFlash(`Caveman → ${val}`); },
    });
  }

  // token (default) — edit token untuk token bernama `name`
  return h(TextInput, {
    placeholder: `token untuk "${m.name || "aip"}" (Enter kosong = hapus)…`,
    defaultValue: "",
    onSubmit: val => {
      const name = m.name || "aip";
      const trimmed = val.trim();
      const clone = { ...cfg, tokens: cfg.tokens.map(t => ({ ...t })) };
      const idx = clone.tokens.findIndex(t => t.name === name);
      if (idx >= 0) clone.tokens[idx].token = trimmed;
      else clone.tokens.push({ name, token: trimmed });
      updateCfg(() => clone);
      onFlash(`Token "${name}" ${trimmed ? "diset" : "dikosongkan"}`);
      commit();
    },
  });
}

function modalPrompt(m) {
  if (m.type === "token") return `Token untuk "${m.name}" →`;
  if (m.type === "port") return "Port baru →";
  if (m.type === "caveman") return "Caveman level (lite/full/ultra) →";
  if (m.type === "maxtok") return "Default max_tokens (2048) →";
  return "→";
}

// ---- Auto-start jika token sudah dikonfig & server belum jalan ----
render(h(App), { exitOnCtrlC: false });